{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "esnext", "deno.ns"],
    "jsx": "react-jsxdev",
    "jsxImportSource": "react"
  },
  "tasks": {
    "build": "DENO_ENV=development dsbuild --in=src/app.tsx",
    "run": "DENO_ENV=development dsbuild --in=src/app.tsx --live --serve"
  },
  "imports": {
    "react": "npm:react@^18.3.0",
    "react-dom/client": "npm:react-dom@^18.3.0/client",
    "react-dom": "npm:react-dom@^18.3.0"
  }
}